{
  "name": "@agentbuddy/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentBuddy - Local AI Coding Agent",
  "author": "AgentBuddy",
  "main": "dist/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:main": "node esbuild.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.agentbuddy.app",
    "productName": "AgentBuddy",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release2"
    },
    "files": [
      "dist/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  },
  "dependencies": {
    "@agent-core/agent-core": "*",
    "@agentbuddy/shared": "*",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "pdfjs-dist": "^6.3.289",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.24.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "to-ico": "^1.1.5",
    "vite": "^5.4.11"
  }
}
