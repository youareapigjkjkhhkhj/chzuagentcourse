# EduAgentX backend configuration template
# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#   cp .env.example .env
# Generate SECRET_KEY / FERNET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_ENV=development
LOG_LEVEL=INFO

# --- Required: app secrets (AGENTS.md sec.4.1) ---
SECRET_KEY=
FERNET_KEY=

# --- Database ---
# Leave empty to use backend/data/eduagentx.db (SQLite, WAL)
DATABASE_URL=

# --- Uploads ---
UPLOAD_DIR=
MAX_CONTENT_LENGTH=20971520

# --- Text LLM (OpenAI-compatible) ---
# Used for slides, lecture script, quiz, discussion topic generation.
# Providers: deepseek | openai | qwen | kimi | ark | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# --- Course generation (P1) ---
# Per-page budget in seconds. Independent of LLM_TIMEOUT (that one is the shared
# HTTP client's transport timeout). A slow page is abandoned and marked failed
# instead of holding up the whole course.
GEN_PAGE_TIMEOUT=60

# --- Volcengine speech: large-model TTS 2.0 (bidirectional streaming WS) ---
# Used for narrating the lecture script. Binary private frames.
VOLC_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_AUDIO_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
VOLC_TTS_SPEECH_RATE=0
VOLC_TTS_ENABLE_SUBTITLE=true
# Speaker must come from the TTS 2.0 (_uranus_bigtts) pool -- NOT the realtime pool.
VOLC_TTS_SPEAKER=
# Built-in voice cards seeded into the DB (`flask seed`). Leave empty and the
# settings page will honestly show "voice id not configured" instead of faking it.
VOLC_TTS_VOICE_TEACHER=
VOLC_TTS_VOICE_HISTORY=
VOLC_TTS_VOICE_SCIENCE=

# --- Volcengine speech: end-to-end realtime dialogue (full duplex) ---
# Used for the AI classmate conversation. Plain JSON text frames + base64 audio.
VOLC_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOLC_REALTIME_API_KEY=
VOLC_REALTIME_MODEL=
# Speaker must come from the realtime (_jupiter_bigtts) pool -- only 4 zh voices.
VOLC_REALTIME_SPEAKER=
VOLC_REALTIME_QPM_LIMIT=60

# --- Volcengine speech: streaming ASR ---
# Fallback when realtime dialogue is unavailable; also powers push-to-talk.
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_PACKET_MS=200

# --- Generation defaults ---
DEFAULT_PAGE_COUNT=12
DEFAULT_CLASSMATE_COUNT=3

# --- Dev only: allowed browser origins for CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
