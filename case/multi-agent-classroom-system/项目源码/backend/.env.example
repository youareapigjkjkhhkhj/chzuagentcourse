# EduAgentX backend configuration template
# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#   cp .env.example .env
# Generate SECRET_KEY / FERNET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_ENV=development
LOG_LEVEL=INFO

# --- Required: app secrets (AGENTS.md sec.4.1) ---
SECRET_KEY=
FERNET_KEY=

# --- Database ---
# Leave empty to use backend/data/eduagentx.db (SQLite, WAL)
DATABASE_URL=

# --- Uploads ---
UPLOAD_DIR=
MAX_CONTENT_LENGTH=20971520

# --- Text LLM (OpenAI-compatible) ---
# Used for slides, lecture script, quiz, discussion topic generation.
# Providers: deepseek | openai | qwen | kimi | ark | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# --- Course generation (P1) ---
# Per-page budget in seconds. Independent of LLM_TIMEOUT (that one is the shared
# HTTP client's transport timeout). A slow page is abandoned and marked failed
# instead of holding up the whole course.
GEN_PAGE_TIMEOUT=60

# --- Volcengine speech: large-model TTS 2.0 (bidirectional streaming WS) ---
# Used for narrating the lecture script. Binary private frames.
VOLC_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_AUDIO_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
VOLC_TTS_SPEECH_RATE=0
VOLC_TTS_ENABLE_SUBTITLE=true
# Per-synthesis timeout in seconds. 0 = use the provider's own default.
VOLC_TTS_TIMEOUT=0
# Speaker must come from the TTS 2.0 (_uranus_bigtts) pool -- NOT the realtime pool.
VOLC_TTS_SPEAKER=
# Built-in voice cards seeded into the DB (`flask seed`). Leave empty and the
# settings page will honestly show "voice id not configured" instead of faking it.
# Each teacher needs TWO ids: one from the TTS 2.0 pool (_uranus_bigtts) below,
# one from the realtime pool (_jupiter_bigtts) -- the two pools do not interchange.
# The pairing this project ships with (catalog: 项目文档/材料/音色文档.md):
#   teacher (male, calm)      zh_male_m191_uranus_bigtts        / zh_male_yunzhou_jupiter_bigtts
#   history (female, literate)zh_female_vv_uranus_bigtts        / zh_female_vv_jupiter_bigtts
#   science (male, energetic) zh_male_huolixiaoge_uranus_bigtts / zh_male_xiaotian_jupiter_bigtts
VOLC_TTS_VOICE_TEACHER=
VOLC_TTS_VOICE_HISTORY=
VOLC_TTS_VOICE_SCIENCE=

# --- Volcengine speech: end-to-end realtime dialogue (full duplex) ---
# Used for the AI classmate conversation. Plain JSON text frames + base64 audio.
VOLC_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOLC_REALTIME_API_KEY=
# Dialogue model version, sent as `session.model`. Not optional: the session
# gets rejected without it. 1.2.6.1 is what the official duplex demo ships
# (project docs: 材料/python3.7_duplex_demo/config.toml).
VOLC_REALTIME_MODEL=1.2.6.1
# Speaker must come from the realtime (_jupiter_bigtts) pool -- only 4 zh voices.
VOLC_REALTIME_SPEAKER=
VOLC_REALTIME_QPM_LIMIT=60
# The same three teachers again, but their realtime-pool ids. Kept next to the
# TTS ids on purpose: swapping one pool for the other is the single most common
# misconfiguration (upstream answers InvalidSpeaker), so both live in one place.
VOLC_REALTIME_VOICE_TEACHER=
VOLC_REALTIME_VOICE_HISTORY=
VOLC_REALTIME_VOICE_SCIENCE=

# --- Volcengine speech: streaming ASR ---
# Fallback when realtime dialogue is unavailable; also powers push-to-talk.
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_API_KEY=
# The docs say `volc.seedasr.sauc.duration`, but that SKU 403s with
# "requested resource not granted" on an account that only opened the
# recording-file recognition service. `volc.seedasr.auc` is the id that grant
# actually hands out, and it serves this same endpoint (verified 2026-09-13:
# handshake 101 plus a full protocol exchange). If your account did open the
# streaming SKU, either value works.
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_PACKET_MS=200

# --- Speech assets and switches (P2) ---
# Where synthesized audio lands: {AUDIO_DIR}/{course_id}/{beat_id}_{hash8}.mp3.
# The DB only stores paths relative to backend/, so this is the one place that
# has to change when the tree moves. data/ is gitignored.
AUDIO_DIR=
# Master switch. false => a plain-text classroom: script, captions and typed Q&A
# still work, there is just no sound. Not a hidden feature -- a usable downgrade.
VOICE_ENABLED=true
# Pre-synthesis runs sequentially, on purpose: the TTS provider reuses one upstream
# connection and holds a lock for a whole synthesis, so threads would only queue up
# behind it -- while making "how many requests does the vendor see at once" (the
# thing its rate limit is measured in) impossible to answer.
# The fixed sentence the settings page auditions (its hash keys the preview cache).
VOICE_PREVIEW_TEXT=同学们好，我是这节课的老师。
# Price list for the estimated-cost readout, in CNY. 0 = not configured, and the
# UI says so instead of inventing a number -- list prices differ per contract.
VOICE_TTS_PRICE_PER_KCHARS=0
VOICE_REALTIME_PRICE_PER_MINUTE=0
VOICE_ASR_PRICE_PER_MINUTE=0

# --- Cost dashboard (P5) ---
# Text-model price list, in CNY per 1k tokens. Prompt and completion are separate
# because the two are often several times apart, and the settings page can override
# these (settings_kv.pricing) -- see services/usage/pricing.py. 0 = not configured.
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0
# When "a day" starts, as an offset from UTC in hours (8 = Beijing). Everything is
# stored in UTC, but the dashboard axis, daily_usage.date and the daily budget reset
# all have to agree -- on a UTC day the budget would reset at 08:00 Beijing time.
USAGE_DAY_OFFSET_HOURS=8

# --- Generation defaults ---
DEFAULT_PAGE_COUNT=12
DEFAULT_CLASSMATE_COUNT=3

# --- Site access code (P5-A13, optional) ---
# Empty = off (the local single-machine default). Set it before putting this on a
# network: anyone who can reach the port can otherwise use your API keys.
# The gate covers pages, /api/* and /ws/*; /api/health stays open so the container
# healthcheck can still reach it. Change the value to log everybody out.
SITE_ACCESS_CODE=
# How long a passed browser is remembered, in seconds (default 7 days).
ACCESS_TTL_SECONDS=604800
# Only set this to true behind HTTPS: on plain http the browser drops a Secure
# cookie and the gate page reappears after a correct code.
ACCESS_COOKIE_SECURE=false
# Per-IP attempts allowed inside the window. 0 = unlimited (local debugging).
ACCESS_RATE_LIMIT_COUNT=10
ACCESS_RATE_LIMIT_WINDOW=60

# --- Audit (P5-A14) ---
# Whether audit rows take the client IP from X-Forwarded-For. Turn it on ONLY when
# actually behind a reverse proxy -- the header is client-supplied, so trusting it
# unconditionally makes the audited IP whatever the caller claims.
AUDIT_TRUST_PROXY=false

# --- Backup (P5-C3) ---
# Where `flask backup` writes (default backend/data/backups, i.e. inside the volume).
BACKUP_DIR=
# Keep the newest N archives (0 = keep all). Default 7 pairs with a daily cron.
BACKUP_KEEP=7

# --- Logging ---
# Empty = stdout only, which is what containers want. Set a path (e.g.
# /var/log/eduagentx/app.log) to also write rotating files; the same redaction
# filter is attached to both handlers.
LOG_FILE=
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5

# --- Production only: the built frontend to serve (P5 sec.6) ---
# Empty = backend/frontend/dist. When that directory is missing, the backend serves
# the API only and Vite keeps serving the pages in development.
FRONTEND_DIST=

# --- Dev only: allowed browser origins for CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
